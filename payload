function s {
   git status
}

function p {
   git push
}

function c {
   git add .
   git commit
}

function fcp {
   git fetch origin
   git checkout main
   git pull
}

function nb {
   git checkout -b ${1}
}

#clear docker containers
function cdc {
   docker ps -aq | xargs docker stop | xargs docker rm
}

function cdi {
   docker images | awk '{ print $3 }' | xargs docker rmi
}

function ac {
   python3 /Users/${USER}/git/personal-terminal-helpers/auto_commit.py
}

#set env var without the value entering command history
function sev {
   if [[ -z "${1}" ]]; then
      echo "usage: sev ENV_VAR_NAME"
      return 1
   fi
   local value
   read -rs "value?Enter value for ${1}: "
   echo
   export ${1}="${value}"
}

